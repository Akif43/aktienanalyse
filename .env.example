# Kopie nach .env (lokal) bzw. als Environment Variables in Vercel eintragen. Niemals committen.
# Yahoo, KAP und Google News brauchen keinen Key. Alles hier ist optional bzw. für Phase 3/4.

# --- Zugriffsschutz der Daten-API (Vercel: Pflicht, lokal leer lassen) ---------------------------
# Erzeugen: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
APP_TOKEN=

# --- KI-Auswertung (Phase 4) ---------------------------------------------------------------------
# Kostenloser Key: aistudio.google.com -> "Get API key". Standardmodell: gemini-3.1-flash-lite
GEMINI_API_KEY=
# Optional anderes Modell, z. B. gemini-3.8-flash (laut Drittquellen nur ca. 20 Anfragen/Tag gratis)
GEMINI_MODEL=
# Optionaler Ausweichanbieter (kostenloser Key: console.groq.com). Standardmodell: openai/gpt-oss-120b
GROQ_API_KEY=
GROQ_MODEL=
# Nur lokale Entwicklung (aus Vercel nicht erreichbar): Ollama
OLLAMA_URL=
OLLAMA_MODEL=
# "demo" = Platzhaltertexte ohne echte KI, nur zum Ausprobieren der Oberfläche
AI_PROVIDER=
# Höchstzahl KI-Anfragen pro Tag (Schutz des Gratis-Kontingents), Standard 300
AI_DAILY_LIMIT=

# --- Dauerhafter Zwischenspeicher für KI-Auswertungen (empfohlen, kostenlos) ---------------------
# Supabase -> Project Settings -> API. Der service_role-Key ist geheim: nur serverseitig verwenden!
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- US-Live-Kurse und US-News (optional) --------------------------------------------------------
# Kostenloser Key: finnhub.io
FINNHUB_API_KEY=

# --- Phase 5: Alarme (Push über ntfy, für npm run monitor bzw. .github/workflows/monitor.yml) -----
# Langes Zufalls-Topic erzeugen: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
# Dasselbe Topic in der ntfy-App (ntfy.sh oder eigene Instanz) abonnieren. Kein Account nötig.
NTFY_TOPIC=
# Nur bei einer eigenen ntfy-Instanz nötig, sonst leer lassen (Standard https://ntfy.sh)
NTFY_URL=
# Optional: Adresse der App, damit ein Antippen der Benachrichtigung direkt zur Aktie führt
APP_URL=
