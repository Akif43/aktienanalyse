{
  "name": "aktienanalyse",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p packages/core && tsc --noEmit -p packages/server && tsc --noEmit -p apps/web",
    "smoke": "tsx scripts/smoke.ts",
    "spike": "tsx scripts/spike-reach.ts",
    "reference": "python tools/make-reference.py",
    "dev": "vite --config apps/web/vite.config.ts",
    "build": "npm run build:web && node tools/vercel-output.mjs",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "icons": "node tools/make-icons.mjs",
    "analyze": "tsx scripts/analyze.ts",
    "check:ai": "tsx scripts/check-ai-endpoints.ts",
    "monitor": "tsx scripts/monitor.ts",
    "start": "node tools/serve-prod.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.0",
    "sharp": "^0.35.4",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.0.0",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.103.1",
    "lightweight-charts": "^5.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  }
}
